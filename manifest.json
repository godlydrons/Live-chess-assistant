{
  "manifest_version": 3,
  "name": "Lichess Engine Pilot",
  "version": "9.0.0",
  "description": "Local Stockfish 19 ASM.js Engine — Zero CSP, Android & Desktop.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://stockfish.online/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "icon.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": { "128": "icon.png" }
}
